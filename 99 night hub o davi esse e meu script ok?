-- Aba Teleportar
local TeleportTab = Window:CreateTab("Teleportar", 4483362458)
local TeleportSection = TeleportTab:CreateSection("Teleportes")

local TeleportButton = TeleportTab:CreateButton({
   Name = "Teleportar para Fogueira",
   Callback = function()
      local player = game.Players.LocalPlayer
      local character = player.Character or player.CharacterAdded:Wait()
      local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
      
      -- Procura pela fogueira de várias formas possíveis
      local campfire = nil
      
      -- Tenta encontrar no workspace
      for _, obj in pairs(workspace:GetDescendants()) do
         if obj.Name:lower():find("campfire") or 
            obj.Name:lower():find("fogueira") or 
            obj.Name:lower():find("fire") or
            obj.Name:lower():find("bonfire") then
            if obj:IsA("BasePart") or obj:IsA("Model") then
               campfire = obj
               break
            end
         end
      end
      
      if campfire then
         local targetCFrame
         if campfire:IsA("Model") then
            targetCFrame = campfire:GetPivot()
         else
            targetCFrame = campfire.CFrame
         end
         humanoidRootPart.CFrame = targetCFrame + Vector3.new(0, 5, 0)
         Rayfield:Notify({
            Title = "Teleporte",
            Content = "Teleportado para a fogueira!",
            Duration = 3,
            Image = 4483362458,
         })
      else
         Rayfield:Notify({
            Title = "Erro",
            Content = "Fogueira não encontrada! Verifique o nome no Explorer.",
            Duration = 3,
            Image = 4483362458,
         })
      end
   end,
})

